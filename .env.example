# Sentinel — environment variable NAMES only. NEVER commit real values.
# Secrets live in the macOS keychain (security add-generic-password -s NAME -w VALUE -U)
# and are read at runtime. This file documents what the system looks for.

# --- Storage ---
# SENTINEL_HOME=/Users/you/.sentinel        # default: ~/.sentinel

# --- LLM auth ---
# Preferred: inherit Claude Code's own ~/.claude/settings.json (or an LLM gateway). Nothing to set.
# Direct SDK calls (optional): ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY (keychain)
# TFY_ENABLED=1   # if routing through the TrueFoundry gateway

# --- Channels (keychain) ---
# SENTINEL_TELEGRAM_TOKEN     # from @BotFather
# SENTINEL_TELEGRAM_CHAT_ID   # your Telegram numeric chat id
# SENTINEL_WHATSAPP_TO        # E.164 number OpenClaw delivers WhatsApp to (dedicated number)

# --- GitHub (keychain; use a fresh personal-scoped token) ---
# GITHUB_TOKEN

# --- Research (already in keychain) ---
# GEMINI_API_KEY

# --- Google Workspace (via gog OAuth already authorized; or paths) ---
# GOOGLE_CLIENT_SECRET_PATH
# GOOGLE_TOKEN_PATH

# --- Host behavior ---
# SENTINEL_ALWAYS_ON=1        # set on the spare always-on Mac (relaxes idle-gate)
# SENTINEL_IDLE_THRESHOLD=300 # seconds of user-idle before heavy work runs
# SENTINEL_REPORT_WINDOW=24   # hours covered by the daily report

# --- Owner identity ---
# SENTINEL_GOOGLE_ACCOUNT=you@example.com   # the Google account gog is authorized for
# TFY_BASE_URL=https://llm-gateway.example.com  # only if you route through an LLM gateway
