{
  "effortLevel": "high",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /*)",
      "Bash(sudo*)",
      "Bash(aws * delete*)",
      "Bash(aws * terminate*)",
      "Bash(npm publish*)",
      "Bash(:(){*)",
      "Read(**/.env)",
      "Read(**/credentials.json)",
      "Read(**/.aws/credentials)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr merge*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash "$CLAUDE_PROJECT_DIR/.claude/hooks/deny-guard.sh"" }
        ]
      }
    ]
  }
}
